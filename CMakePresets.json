{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native host build",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "sigmastar",
      "displayName": "SigmaStar 26T-Pro (armhf, gcc-11)",
      "binaryDir": "${sourceDir}/build/sigmastar",
      "toolchainFile": "${sourceDir}/cmake/toolchains/sigmastar-arm-linux-gnueabihf.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "native",    "configurePreset": "native" },
    { "name": "sigmastar", "configurePreset": "sigmastar" }
  ]
}
